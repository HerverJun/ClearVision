{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clearvision/operator_knowledge_schema.v2.json",
  "title": "ClearVision Operator Knowledge Card",
  "type": "object",
  "required": [
    "SchemaVersion",
    "OperatorType",
    "DisplayName",
    "CategoryId",
    "CategoryOrder",
    "Category",
    "Lifecycle",
    "DefaultAiRecommendation",
    "RequiresLifecycleDisclosure",
    "Inputs",
    "Outputs",
    "Parameters",
    "ImageInputContracts",
    "KnownLimitations",
    "Evidence"
  ],
  "properties": {
    "SchemaVersion": {
      "const": "2026-07.operator-knowledge-card.v2"
    },
    "OperatorType": {
      "type": "string",
      "minLength": 1
    },
    "DisplayName": {
      "type": "string",
      "minLength": 1
    },
    "CategoryId": {
      "type": "string",
      "minLength": 1
    },
    "CategoryOrder": {
      "type": "integer",
      "minimum": 0
    },
    "Category": {
      "type": "string",
      "minLength": 1
    },
    "Lifecycle": {
      "type": "string"
    },
    "LifecycleNote": {
      "type": ["string", "null"]
    },
    "DefaultHidden": {
      "type": "boolean"
    },
    "DefaultAiRecommendation": {
      "type": "boolean"
    },
    "RequiresLifecycleDisclosure": {
      "type": "boolean"
    },
    "Aliases": {
      "$ref": "#/$defs/stringArray"
    },
    "IntentTags": {
      "$ref": "#/$defs/stringArray"
    },
    "ScenarioTags": {
      "$ref": "#/$defs/stringArray"
    },
    "Inputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/portDefinition"
      }
    },
    "Outputs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/portDefinition"
      }
    },
    "Parameters": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/parameterDefinition"
      }
    },
    "ParameterConditions": {
      "type": "array"
    },
    "OutputConditions": {
      "type": "array"
    },
    "ImageInputContracts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/imageContractPresentation"
      }
    },
    "ResourceRequirements": {
      "type": "array"
    },
    "GenerationDependencies": {
      "$ref": "#/$defs/stringArray"
    },
    "GenerationFingerprint": {
      "type": "string"
    },
    "RequiredResources": {
      "$ref": "#/$defs/stringArray"
    },
    "TypicalUpstream": {
      "$ref": "#/$defs/stringArray"
    },
    "TypicalDownstream": {
      "$ref": "#/$defs/stringArray"
    },
    "AntiPatterns": {
      "$ref": "#/$defs/stringArray"
    },
    "KnownLimitations": {
      "$ref": "#/$defs/stringArray"
    },
    "Evidence": {
      "$ref": "#/$defs/evidenceDefinition"
    }
  },
  "$defs": {
    "stringArray": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "portDefinition": {
      "type": "object",
      "required": ["Name", "DisplayName", "DataType", "IsRequired"],
      "properties": {
        "Name": { "type": "string" },
        "DisplayName": { "type": "string" },
        "DataType": { "type": "string" },
        "IsRequired": { "type": "boolean" },
        "Description": { "type": ["string", "null"] }
      }
    },
    "parameterDefinition": {
      "type": "object",
      "required": ["Name", "DisplayName", "DataType", "IsRequired", "AllowedValues"],
      "properties": {
        "Name": { "type": "string" },
        "DisplayName": { "type": "string" },
        "DataType": { "type": "string" },
        "Description": { "type": ["string", "null"] },
        "DefaultValue": { "type": ["string", "null"] },
        "MinValue": { "type": ["string", "null"] },
        "MaxValue": { "type": ["string", "null"] },
        "IsRequired": { "type": "boolean" },
        "AllowedValues": {
          "$ref": "#/$defs/stringArray"
        }
      }
    },
    "imageContractPresentation": {
      "type": "object",
      "required": [
        "InputPort",
        "ContractVersion",
        "AllowedVariantCount",
        "VerifiedSupportVariantCount",
        "VerifiedConversionVariantCount",
        "LegacyCompatibilityVariantCount",
        "VerifiedRejectionVariantCount",
        "UnknownVariantCount",
        "HasProductionSupport",
        "CompatibilityOnly",
        "EvidenceSummary",
        "ExactVariantGroups"
      ],
      "properties": {
        "InputPort": { "type": "string" },
        "ContractVersion": { "const": "2.1" },
        "AllowedVariantCount": { "type": "integer", "minimum": 0 },
        "VerifiedSupportVariantCount": { "type": "integer", "minimum": 0 },
        "VerifiedConversionVariantCount": { "type": "integer", "minimum": 0 },
        "LegacyCompatibilityVariantCount": { "type": "integer", "minimum": 0 },
        "VerifiedRejectionVariantCount": { "type": "integer", "minimum": 0 },
        "UnknownVariantCount": { "type": "integer", "minimum": 0 },
        "HasProductionSupport": { "type": "boolean" },
        "CompatibilityOnly": { "type": "boolean" },
        "EvidenceSummary": { "type": "string" },
        "ExactVariantGroups": {
          "type": "array",
          "items": { "$ref": "#/$defs/imageContractVariantGroup" }
        }
      }
    },
    "imageContractVariantGroup": {
      "type": "object",
      "required": [
        "Mode",
        "Condition",
        "Admission",
        "Verification",
        "ExactInputTypes",
        "ConversionPolicy",
        "OutputDepthPolicy",
        "DynamicRangePolicy",
        "InputValuePolicy",
        "FailureCode",
        "EvidenceLevel"
      ],
      "properties": {
        "Mode": { "type": "string" },
        "Condition": { "type": "string" },
        "Admission": { "enum": ["Allowed", "Rejected", "Unknown"] },
        "Verification": {
          "enum": [
            "VerifiedSupport",
            "VerifiedConversion",
            "LegacyCompatibilityAllowance",
            "VerifiedRejection",
            "Unknown"
          ]
        },
        "ExactInputTypes": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "pattern": "^CV_.+C[1-9][0-9]*$" }
        },
        "ConversionPolicy": { "type": "string" },
        "OutputDepthPolicy": { "type": "string" },
        "DynamicRangePolicy": { "type": "string" },
        "InputValuePolicy": {
          "enum": ["Any", "RejectNonFinite", "RequireFiniteFloat32Representable"]
        },
        "FailureCode": { "type": "string" },
        "EvidenceLevel": { "type": "string" }
      }
    },
    "evidenceDefinition": {
      "type": "object",
      "required": [
        "Contract",
        "Golden",
        "Dataset",
        "FieldReplay",
        "PrecisionClaim",
        "IndustrialStatus"
      ],
      "properties": {
        "Contract": { "type": "string" },
        "Golden": { "type": "string" },
        "Dataset": { "type": "string" },
        "FieldReplay": { "type": "string" },
        "PrecisionClaim": { "type": "string" },
        "IndustrialStatus": { "type": "string" }
      }
    }
  }
}
