<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>12.0</LangVersion>
    <RootNamespace>Acme.Product.Infrastructure</RootNamespace>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
  </PropertyGroup>

  <ItemGroup>
    <!-- 鏁版嵁搴?-->
    <PackageReference Include="AutoMapper.Extensions.Microsoft.DependencyInjection" />
    <PackageReference Include="CsvHelper" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="NModbus" />
    
    <!-- 鍥惧儚澶勭悊 -->
    <PackageReference Include="OpenCvSharp4" />
    <!-- 銆怭3-O3.1 GPU鍔犻€熴€戞牴鎹洰鏍囧钩鍙伴€夋嫨杩愯鏃讹細 -->
    <!-- CPU鐗堟湰锛堥粯璁わ級锛歄penCvSharp4.runtime.win -->
    <!-- GPU鐗堟湰锛堥渶NVIDIA GPU + CUDA锛夛細OpenCvSharp4.runtime.win_gpu -->
    <PackageReference Include="OpenCvSharp4.runtime.win" />
    <PackageReference Include="PaddleOCRSharp" />
    <!-- <PackageReference Include="OpenCvSharp4.runtime.win_gpu" /> -->
    
    <!-- 鏉＄爜璇嗗埆 -->
    <PackageReference Include="ZXing.Net" />
    
    <!-- Modbus閫氫俊 -->
    <PackageReference Include="System.IO.Ports" />
    
    <!-- 瀵嗙爜鍝堝笇 -->
    <PackageReference Include="BCrypt.Net-Next" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" />
    
    <!-- SQLite / SQL Server / MySQL -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
    <PackageReference Include="Microsoft.Data.SqlClient" />
    <PackageReference Include="MySqlConnector" />
    
    <!-- ONNX Runtime -->
    <!-- 銆怭3-O3.1 GPU鍔犻€熴€慍PU鐗堟湰锛堥粯璁わ級 -->
    <PackageReference Include="Microsoft.ML.OnnxRuntime" />
    <PackageReference Include="Microsoft.ML.OnnxRuntime.Managed" />
    <!-- 銆怭3-O3.1 GPU鍔犻€熴€慓PU鐗堟湰锛堝惎鐢ㄦ椂闇€鏇挎崲CPU鍖咃級 -->
    <!-- CUDA鏀寔锛歁icrosoft.ML.OnnxRuntime.Gpu -->
    <!-- TensorRT鏀寔锛歁icrosoft.ML.OnnxRuntime.TensorRT -->
    <!-- DirectML鏀寔锛歁icrosoft.ML.OnnxRuntime.DirectML -->
    
    <!-- 鏂囦欢澶勭悊 -->
    <PackageReference Include="System.Drawing.Common" />
    
    <!-- 鏃ュ織 -->
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Serilog.Sinks.File" />
    <PackageReference Include="Serilog.Exceptions" />
    
    <PackageReference Include="Microsoft.Extensions.Hosting.Abstractions" />
    <PackageReference Include="Microsoft.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acme.Product.Core\Acme.Product.Core.csproj" />
    <ProjectReference Include="..\Acme.Product.Application\Acme.Product.Application.csproj" />
    <ProjectReference Include="..\Acme.Product.Contracts\Acme.Product.Contracts.csproj" />
    <ProjectReference Include="..\Acme.PlcComm\Acme.PlcComm.csproj" />
  </ItemGroup>

  <!-- 鍗庣澘鐩告満 SDK -->
  <ItemGroup>
    <Reference Include="MVSDK_Net">
      <HintPath>..\..\lib\HuaraySDK\x64\MVSDK_Net.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <!-- 鍗庣澘 SDK 鍘熺敓杩愯鏃朵緷璧?鈫?澶嶅埗鍒拌緭鍑虹洰褰?-->
  <ItemGroup>
    <None Include="..\..\lib\HuaraySDK\x64\**\*.*"
          Exclude="..\..\lib\HuaraySDK\x64\MVSDK_Net.dll;..\..\lib\HuaraySDK\x64\MVSDK_Net.XML">
      <Link>%(Filename)%(Extension)</Link>
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

</Project>
