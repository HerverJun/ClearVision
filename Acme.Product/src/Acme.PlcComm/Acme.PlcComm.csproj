<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>Acme.PlcComm</AssemblyName>
    <RootNamespace>Acme.PlcComm</RootNamespace>
    <Version>1.0.0</Version>
    <Authors>ClearVision Team</Authors>
    <Description>High-performance industrial PLC communication framework for Siemens S7, Mitsubishi MC, and Omron FINS protocols</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Newtonsoft.Json" />
    <PackageReference Include="System.IO.Ports" />
    <PackageReference Include="HslCommunication" />
  </ItemGroup>

</Project>
