<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <Platforms>x64</Platforms>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <UseWindowsForms>false</UseWindowsForms>
    <UseWPF>false</UseWPF>
    <UseWinUI>false</UseWinUI>
    
    <!-- MSIX 鎵撳寘閰嶇疆 -->
    <PublishProfile>Properties\PublishProfiles\MSIX.pubxml</PublishProfile>
    <GenerateAppInstallerFile>false</GenerateAppInstallerFile>
    <AppxPackageSigningEnabled>false</AppxPackageSigningEnabled>
    <AppxBundle>Never</AppxBundle>
    <AppxBundlePlatforms>x64</AppxBundlePlatforms>
    <HoursBetweenUpdateChecks>0</HoursBetweenUpdateChecks>
    
    <!-- 搴旂敤淇℃伅 -->
    <ApplicationTitle>ClearVision</ApplicationTitle>
    <ApplicationDescription>宸ヤ笟瑙嗚妫€娴嬭蒋浠?- 鍩轰簬.NET 8鍜學ebView2鐨勭幇浠ｆ闈㈠簲鐢?/ApplicationDescription>
    <ApplicationDisplayVersion>1.0.0</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    
    <!-- 鍙戝竷閰嶇疆 -->
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\Acme.Product.Desktop\Acme.Product.Desktop.csproj" />
  </ItemGroup>

  <!-- MSIX 娓呭崟鏂囦欢 -->
  <ItemGroup>
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <!-- 璧勬簮鏂囦欢 -->
  <ItemGroup>
    <Content Include="Images\*.png" />
    <Content Include="Images\*.jpg" />
    <Content Include="Images\*.ico" />
  </ItemGroup>

</Project>