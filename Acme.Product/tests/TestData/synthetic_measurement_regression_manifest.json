{
  "schemaVersion": 1,
  "name": "synthetic_measurement_regression_manifest",
  "description": "Synthetic regression datasets for measurement, calibration, point-cloud, edge, and caliper operator tests.",
  "source": {
    "type": "repo-generated synthetic",
    "generator": "Inline deterministic C# test factories under Acme.Product.Tests.Operators",
    "portablePublishDependency": false
  },
  "datasets": [
    {
      "id": "pixel_world_scale_offset_round_trip",
      "ownerTest": "PixelToWorldTransformOperatorTests.ExecuteAsync_WithPlanarBundle_ShouldRoundTripPixelAndWorldPointLists",
      "source": "CalibrationBundleV2TestData.CreateAcceptedScaleOffsetBundleJson",
      "units": {
        "input": "px",
        "world": "mm"
      },
      "expected": {
        "scaleX": 0.02,
        "scaleY": 0.02,
        "roundTripMaxPx": 1e-9
      },
      "tolerance": {
        "pixelRoundTripPx": 1e-9,
        "worldMm": 1e-9
      }
    },
    {
      "id": "npoint_affine_outlier_ransac",
      "ownerTest": "NPointCalibrationOperatorTests.ExecuteAsync_WithAffineOutliers_ShouldKeepInlierCalibrationAccepted",
      "source": "Inline deterministic point-pair JSON",
      "units": {
        "image": "px",
        "world": "mm"
      },
      "expected": {
        "accepted": true,
        "totalSampleCount": 10,
        "minimumInlierCount": 8,
        "meanReprojectionErrorMaxMm": 0.05
      },
      "tolerance": {
        "reprojectionMm": 0.05
      }
    },
    {
      "id": "npoint_affine_loose_residual_threshold",
      "ownerTest": "NPointCalibrationOperatorTests.ExecuteAsync_WithLooseAffineResidualThreshold_ShouldAcceptSmallSyntheticNoise",
      "source": "Inline deterministic sub-pixel residual point-pair JSON",
      "units": {
        "image": "px",
        "world": "mm"
      },
      "expected": {
        "accepted": true,
        "maxReprojectionErrorMaxMm": 0.5
      },
      "tolerance": {
        "maxReprojectionMm": 0.5
      }
    },
    {
      "id": "npoint_affine_strict_residual_threshold",
      "ownerTest": "NPointCalibrationOperatorTests.ExecuteAsync_WithStrictAffineResidualThreshold_ShouldRejectSameSyntheticNoise",
      "source": "Inline deterministic noisy affine point-pair JSON",
      "units": {
        "image": "px",
        "world": "mm"
      },
      "expected": {
        "accepted": false,
        "maxAcceptedReprojectionErrorMm": 0.001
      },
      "tolerance": {
        "strictReprojectionThresholdMm": 0.001
      }
    },
    {
      "id": "point_cloud_large_coordinate_small_voxel_motion",
      "ownerTest": "VoxelDownsampleOperatorTests.ExecuteAsync_WithLargeCoordinatesAndSmallVoxelMotion_ShouldPreserveCentroidOffset",
      "source": "Inline four-point CV_32FC1 point cloud",
      "units": {
        "pointCloud": "mm"
      },
      "expected": {
        "leafSize": 1.0,
        "outputPointCount": 1,
        "centroid": [10000.1875, 20000.1875, 30000.1875]
      },
      "tolerance": {
        "centroidMm": 0.002
      }
    },
    {
      "id": "edge_low_contrast_noisy_rectangle",
      "ownerTest": "EdgeDetectionOperatorTests.ExecuteAsync_WithLowContrastNoisyRectangle_ShouldKeepSparseUsableEdges",
      "source": "Inline seeded noise image, seed=223",
      "units": {
        "imageIntensity": "uint8",
        "edgeDensity": "ratio"
      },
      "expected": {
        "background": 96,
        "foreground": 112,
        "noiseInclusiveRange": [-2, 2],
        "threshold1": 6.0,
        "threshold2": 12.0,
        "edgeDensityMin": 0.003,
        "edgeDensityMax": 0.08
      },
      "tolerance": {
        "edgeDensityLowerInclusive": 0.003,
        "edgeDensityUpperExclusive": 0.08
      }
    },
    {
      "id": "caliper_low_contrast_noisy_stripe",
      "ownerTest": "CaliperToolOperatorTests.ExecuteAsync_WithLowContrastNoisyStripe_ShouldMeasureWidthWithinRelaxedTolerance",
      "source": "Inline seeded noise image, seed=407",
      "units": {
        "imageIntensity": "uint8",
        "width": "px"
      },
      "expected": {
        "background": 92,
        "foreground": 112,
        "noiseInclusiveRange": [-2, 2],
        "widthPx": 40.0,
        "maxUncertaintyPx": 1.0
      },
      "tolerance": {
        "widthPx": 0.75,
        "uncertaintyPxExclusiveUpperBound": 1.0
      }
    }
  ]
}
