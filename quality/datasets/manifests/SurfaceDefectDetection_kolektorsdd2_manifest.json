      "ImageAurocMinimum": 0.70,
      "PixelF1Minimum": 0.20,
      "PixelF1RegressionTolerance": 0.02
    }
  },
  "runner": {
    "project": "quality/tools/KolektorSurfaceDefectDatasetRunner/KolektorSurfaceDefectDatasetRunner.csproj",
    "command": "dotnet run --project quality/tools/KolektorSurfaceDefectDatasetRunner/KolektorSurfaceDefectDatasetRunner.csproj -- --index quality/datasets/kolektorsdd2_index.json --output quality/evals/reports/SurfaceDefectDetection_kolektorsdd2_baseline.json --report quality/evals/reports/SurfaceDefectDetection_kolektorsdd2_baseline.md",
