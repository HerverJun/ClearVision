    "command": "dotnet run --project quality/tools/FrameChangeTriggerDatasetRunner/FrameChangeTriggerDatasetRunner.csproj -- --output quality/evals/reports/FrameChangeTrigger_dataset_baseline.json --report quality/evals/reports/FrameChangeTrigger_dataset_baseline.md --field-output quality/evals/reports/FrameChangeTrigger_field_substitute_baseline.json --field-report quality/evals/reports/FrameChangeTrigger_field_substitute_baseline.md",
