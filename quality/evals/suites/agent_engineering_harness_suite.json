          "evidenceKind": "agent_engineering_harness",
          "operators": [
            "ImageAcquisition",
            "TemplateMatching",
            "DeepLearning",
            "CircleMeasurement",
            "MeasureDistance",
            "RuntimePreview",
            "RuntimePackagePrecheck"
          ],
          "command": [
            "powershell",
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-Command",
            "& './scripts/run-dotnet-test-serial.ps1' -Project 'ClearVision.Product/tests/ClearVision.Product.Tests/ClearVision.Product.Tests.csproj' -FullyQualifiedName 'ClearVision.Product.Tests.AI.AgentEvaluation.AgentEngineeringEvaluationHarnessTests,ClearVision.Product.Tests.AI.VisionAgentSkeleton.VisionAgentSkeletonTests,ClearVision.Product.Tests.AI.VisionAgentReadOnlyTools.VisionAgentReadOnlyToolsTests,ClearVision.Product.Tests.AI.VisionAgentSimulationTools.VisionAgentSimulationToolsTests,ClearVision.Product.Tests.AI.VisionAgentDeploymentPrepare.VisionAgentDeploymentPrepareTests,ClearVision.Product.Tests.AI.VisionAgentGenerateFlow.VisionAgentGenerateFlowTests,ClearVision.Product.Tests.AI.VisionAgentPlanner.VisionAgentPlannerTests,ClearVision.Product.Tests.AI.VisionAgentPlannerCompletion.VisionAgentPlannerCompletionTests,ClearVision.Product.Tests.AI.VisionAgentRuntimePreview.VisionAgentRuntimePreviewTests,ClearVision.Product.Tests.AI.VisionAgentRuntimePreviewAdapter.VisionAgentRuntimePreviewAdapterTests,ClearVision.Product.Tests.AI.VisionAgentRuntimePreviewGovernance.VisionAgentRuntimePreviewGovernanceTests,ClearVision.Product.Tests.AI.ParameterRuleParity.VisionAgentParameterRuleParityTests,ClearVision.Product.Tests.AI.VisionAgentPlannerBenchmark.VisionAgentPlannerAutonomyBenchmarkTests,ClearVision.Product.Tests.AI.AiConfigStoreTests,ClearVision.Product.Tests.AI.AiSecretSanitizerTests' -Verbosity minimal -ResultsDirectory 'test_results/agent_engineering_harness' -LogFileName 'agent_engineering_harness.trx' -MinimumTotalTests 253 -MinimumPassedTests 253"
          ],
          "estimatedSeconds": 45
        },
        {
          "id": "vision_agent_ui_contract_tests",
          "status": "active",
          "evidenceKind": "vision_agent_ui_contract",
          "command": [
            "powershell",
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-Command",
            "$outputDir = 'test_results/agent_engineering_harness'; New-Item -ItemType Directory -Force -Path $outputDir | Out-Null; Set-Location 'ClearVision.Product/tests/ClearVision.Product.UI.Tests'; npm run test:agent-ui-contract 2>&1 | Tee-Object -FilePath '../../../test_results/agent_engineering_harness/agent_ui_contract_output.txt'; if ($LASTEXITCODE -ne 0) { exit $LASTEXITCODE }"
          ],
          "minimumTests": 78,
          "notes": "Covers Agent UI contract plus 2026-06-05 workbench modularization, shared parameter rules for AI pending/property/precheck preview paths, Chinese operator names, workbench layout, RuntimePreview Pilot metadata-only permission/fallback/resource trace artifacts, and v1.1 developer-hidden pilot console session/catalog/readiness/simulation/audit/report/replay/export/deploy-readiness/scenario-evidence/retention controls.",
          "estimatedSeconds": 15
        },
        {
          "id": "vision_agent_ai_model_config_endpoint_regression",
          "status": "active",
          "evidenceKind": "vision_agent_ai_model_config_regression",
          "command": [
            "powershell",
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-Command",
            "& './scripts/run-dotnet-test-serial.ps1' -Project 'ClearVision.Product/tests/ClearVision.Product.Desktop.Tests/ClearVision.Product.Desktop.Tests.csproj' -FullyQualifiedName 'ClearVision.Product.Desktop.Tests.AiModelEndpointsTests' -Verbosity minimal -ResultsDirectory 'test_results/agent_engineering_harness' -LogFileName 'agent_ai_model_config_endpoints.trx' -MinimumTotalTests 19 -MinimumPassedTests 19"
          ],
          "minimumTests": 19,
          "notes": "Covers AI model config create/edit/delete active/default planner/default shadow-eval routing, API key keep/replace/clear, secret-store persistence, GET masking, Test Connection failure classification, and RuntimePreview Pilot v1.1 config/catalog/readiness/session/simulation/report/replay/export/deploy-readiness/scenario-evidence/retention endpoints without RuntimePreview real adapter, Station, camera, PLC, packaging, or deployment.",
          "estimatedSeconds": 20
        },
        {
          "id": "vision_agent_business_benchmark",
          "status": "active",
          "evidenceKind": "vision_agent_business_benchmark",
          "baselineJson": "quality/evals/reports/VisionAgent_business_benchmark_baseline.json",
          "reportMarkdown": "quality/evals/reports/VisionAgent_business_benchmark_baseline.md",
          "command": [
            "python",
            "quality/tools/run_vision_agent_business_benchmark.py",
            "--output",
            "quality/evals/reports/VisionAgent_business_benchmark_baseline.json",
            "--report",
            "quality/evals/reports/VisionAgent_business_benchmark_baseline.md"
          ],
          "minimumCases": 37,
          "notes": "Executable offline metadata-only Vision Agent business benchmark with registered tool execution for wire sequence, template matching, hole distance, missing resource, flow modification, parameter completion, RuntimePreview, metadata session simulation, and precheck tasks.",
          "estimatedSeconds": 5
        },
        {
          "id": "vision_agent_runtime_preview_scenario_evidence",
          "status": "active",
          "evidenceKind": "runtime_preview_scenario_evidence",
          "baselineJson": "quality/evals/reports/runtime_preview_scenario_evidence.json",
          "reportMarkdown": "quality/evals/reports/runtime_preview_scenario_evidence.md",
          "command": [
            "python",
            "quality/tools/run_runtime_preview_scenario_evidence.py",
            "--output",
            "quality/evals/reports/runtime_preview_scenario_evidence.json",
            "--report",
            "quality/evals/reports/runtime_preview_scenario_evidence.md",
            "--deploy-output",
            "quality/evals/reports/runtime_preview_deploy_readiness_report.sample.json",
            "--deploy-report",
            "quality/evals/reports/runtime_preview_deploy_readiness_report.sample.md",
            "--audit-output",
            "quality/evals/reports/runtime_preview_governance_audit_sample.json",
            "--audit-report",
            "quality/evals/reports/runtime_preview_governance_audit_sample.md",
            "--minimum-cases",
            "8"
          ],
          "minimumCases": 8,
          "notes": "RuntimePreview v1.1 metadata-only scenario evidence and deploy readiness report matrix. Produces redacted reports for wire sequence, template matching, hole distance, remote control detection, missing resources, dangerous path denial, Station/PLC denial, and runtime package precheck not-ready without real resources.",
          "estimatedSeconds": 3
        },
        {
          "id": "vision_agent_planner_autonomy_benchmark",
          "status": "active",
          "evidenceKind": "vision_agent_planner_autonomy_benchmark",
          "baselineJson": "quality/evals/reports/planner_autonomy_benchmark.json",
          "reportMarkdown": "quality/evals/reports/planner_autonomy_benchmark.md",
          "command": [
            "dotnet",
            "run",
            "--project",
            "quality/tools/VisionAgentPlannerAutonomyBenchmarkRunner/VisionAgentPlannerAutonomyBenchmarkRunner.csproj",
            "--",
            "--output",
            "quality/evals/reports/planner_autonomy_benchmark.json",
            "--report",
            "quality/evals/reports/planner_autonomy_benchmark.md"
          ],
          "minimumCases": 15,
          "minimumNegativeCases": 6,
          "notes": "Planner autonomy benchmark executes mock planner completions through VisionAgentPlannerService, VisionAgentLoop, AgentToolCallPolicy, and registered static/offline tools. Permission negative cases verify denial evidence in policyDecisions, toolTrace, and pendingActions.",
          "estimatedSeconds": 8
        },
        {
          "id": "vision_agent_real_llm_planner_shadow_eval",
          "status": "manual",
          "evidenceKind": "vision_agent_real_llm_planner_shadow_eval",
          "baselineJson": "quality/evals/reports/real_llm_planner_shadow_eval.json",
          "reportMarkdown": "quality/evals/reports/real_llm_planner_shadow_eval.md",
          "command": [
            "dotnet",
            "run",
            "--project",
            "quality/tools/VisionAgentPlannerShadowEvalRunner/VisionAgentPlannerShadowEvalRunner.csproj",
            "--",
            "--output",
            "quality/evals/reports/real_llm_planner_shadow_eval.json",
            "--report",
            "quality/evals/reports/real_llm_planner_shadow_eval.md"
          ],
          "minimumCases": 12,
          "notes": "Manual shadow eval only. It runs a real LLM planner completion source only when CV_AGENT_REAL_LLM_SHADOW_EVAL=true; default CI keeps this as a skipped/sample report and uses mock planner autonomy as the stable gate.",
          "estimatedSeconds": 30
        }
      ]
    }
  ]
