          "evidenceKind": "agent_engineering_harness",
          "operators": [
            "ImageAcquisition",
            "TemplateMatching",
            "DeepLearning",
            "CircleMeasurement",
            "MeasureDistance",
            "RuntimePreview",
            "RuntimePackagePrecheck"
          ],
          "command": [
            "powershell",
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-Command",
            "& './scripts/run-dotnet-test-serial.ps1' -Project 'ClearVision.Product/tests/ClearVision.Product.Tests/ClearVision.Product.Tests.csproj' -FullyQualifiedName 'ClearVision.Product.Tests.AI.AgentEvaluation.AgentEngineeringEvaluationHarnessTests,ClearVision.Product.Tests.AI.VisionAgentSkeleton.VisionAgentSkeletonTests,ClearVision.Product.Tests.AI.VisionAgentReadOnlyTools.VisionAgentReadOnlyToolsTests,ClearVision.Product.Tests.AI.VisionAgentSimulationTools.VisionAgentSimulationToolsTests,ClearVision.Product.Tests.AI.VisionAgentDeploymentPrepare.VisionAgentDeploymentPrepareTests,ClearVision.Product.Tests.AI.VisionAgentGenerateFlow.VisionAgentGenerateFlowTests,ClearVision.Product.Tests.AI.VisionAgentPlanner.VisionAgentPlannerTests,ClearVision.Product.Tests.AI.VisionAgentPlannerCompletion.VisionAgentPlannerCompletionTests,ClearVision.Product.Tests.AI.VisionAgentRuntimePreview.VisionAgentRuntimePreviewTests,ClearVision.Product.Tests.AI.VisionAgentRuntimePreviewAdapter.VisionAgentRuntimePreviewAdapterTests' -Verbosity minimal -ResultsDirectory 'test_results/agent_engineering_harness' -LogFileName 'agent_engineering_harness.trx' -MinimumTotalTests 149 -MinimumPassedTests 149"
          ],
          "estimatedSeconds": 45
        },
        {
          "id": "vision_agent_ui_contract_tests",
          "status": "active",
          "evidenceKind": "vision_agent_ui_contract",
          "command": [
            "powershell",
            "-NoProfile",
            "-ExecutionPolicy",
            "Bypass",
            "-Command",
            "Set-Location 'ClearVision.Product/tests/ClearVision.Product.UI.Tests'; npm run test:agent-ui-contract"
          ],
          "minimumTests": 31,
          "notes": "Covers Agent UI contract plus 2026-06-05 workbench modularization, shared parameter rules for AI pending/property/precheck preview paths, Chinese operator names, workbench layout, and legacy RuntimePreview artifacts.",
          "estimatedSeconds": 15
        },
        {
          "id": "vision_agent_business_benchmark",
          "status": "active",
          "evidenceKind": "vision_agent_business_benchmark",
          "baselineJson": "quality/evals/reports/VisionAgent_business_benchmark_baseline.json",
          "reportMarkdown": "quality/evals/reports/VisionAgent_business_benchmark_baseline.md",
          "command": [
            "python",
            "quality/tools/run_vision_agent_business_benchmark.py",
            "--output",
            "quality/evals/reports/VisionAgent_business_benchmark_baseline.json",
            "--report",
            "quality/evals/reports/VisionAgent_business_benchmark_baseline.md"
          ],
          "minimumCases": 36,
          "notes": "Offline metadata-only Vision Agent business benchmark with wire sequence, template matching, hole distance, missing resource, flow modification, parameter completion, RuntimePreview, and precheck tasks.",
