            "quality/tools/run_quality_suite.py",
            "--suite",
            "quick_contract_suite",
            "--validate-only"
          ],
          "baselineJson": "quality/evals/reports/QualityFlywheel_155_quasi_industrial_registry.json",
          "reportMarkdown": "quality/evals/reports/QualityFlywheel_155_quasi_industrial_registry.md",
          "estimatedSeconds": 30
        },
        {
          "id": "golden_core50_suite_validate",
          "status": "active",
          "evidenceKind": "golden-suite-validation",
          "command": [
            "python",
            "quality/tools/run_quality_suite.py",
            "--suite",
            "golden_core50_suite",
            "--validate-only"
          ],
          "baselineJson": "quality/evals/reports/QualityFlywheel_155_quasi_industrial_registry.json",
          "reportMarkdown": "quality/evals/reports/QualityFlywheel_155_quasi_industrial_registry.md",
          "estimatedSeconds": 30
        },
        {
          "id": "dataset_heavy_suite_validate",
          "status": "active",
          "evidenceKind": "dataset-suite-validation",
          "command": [
            "python",
            "quality/tools/run_quality_suite.py",
            "--suite",
            "dataset_heavy_suite",
            "--validate-only"
          ],
          "baselineJson": "quality/evals/reports/QualityFlywheel_155_quasi_industrial_registry.json",
          "reportMarkdown": "quality/evals/reports/QualityFlywheel_155_quasi_industrial_registry.md",
          "estimatedSeconds": 30
        },
        {
          "id": "core20_proof_suite_validate",
          "status": "active",
          "evidenceKind": "core20-suite-validation",
          "command": [
            "python",
            "quality/tools/run_quality_suite.py",
