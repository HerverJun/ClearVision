{
  "schemaVersion": "2026-07-10.vision-agent-parameter-rule-parity.v2",
  "operatorConstraints": {
    "ImageAcquisition": [
      {
        "parameter": "SourceType",
        "requiredPolicy": "required",
        "reasonCode": "IMAGE_SOURCE_TYPE_REQUIRED"
      },
      {
        "parameter": "FilePath",
        "requiredPolicy": "optional",
        "requiredWhen": {
          "all": [
            { "parameter": "SourceType", "comparison": "equals", "value": "File" }
          ]
        },
        "disabledWhen": {
          "all": [
            { "parameter": "SourceType", "comparison": "equals", "value": "Camera" }
          ]
        },
        "resourceKind": "image_file",
        "reasonCode": "IMAGE_FILE_REQUIRED_FOR_FILE_SOURCE"
      },
      {
        "parameter": "CameraId",
        "requiredPolicy": "optional",
        "requiredWhen": {
          "all": [
            { "parameter": "SourceType", "comparison": "equals", "value": "Camera" }
          ]
        },
        "disabledWhen": {
          "all": [
            { "parameter": "SourceType", "comparison": "equals", "value": "File" }
          ]
        },
        "atLeastOneGroup": "image-camera-source",
        "resourceKind": "camera_binding",
        "reasonCode": "IMAGE_CAMERA_REQUIRED_FOR_CAMERA_SOURCE"
      },
      {
        "parameter": "CameraBindingId",
        "requiredPolicy": "optional",
        "requiredWhen": {
          "all": [
            { "parameter": "SourceType", "comparison": "equals", "value": "Camera" }
          ]
        },
        "disabledWhen": {
          "all": [
            { "parameter": "SourceType", "comparison": "equals", "value": "File" }
          ]
        },
        "atLeastOneGroup": "image-camera-source",
        "aliasFor": "CameraId",
        "resourceKind": "camera_binding",
        "reasonCode": "IMAGE_CAMERA_BINDING_ALIAS"
      },
      {
        "parameter": "ExposureTime",
        "disabledWhen": {
          "all": [
            { "parameter": "SourceType", "comparison": "equals", "value": "File" }
          ]
        },
        "reasonCode": "IMAGE_CAMERA_SETTING_DISABLED_FOR_FILE_SOURCE"
      },
      {
        "parameter": "Gain",
        "disabledWhen": {
          "all": [
            { "parameter": "SourceType", "comparison": "equals", "value": "File" }
          ]
        },
        "reasonCode": "IMAGE_CAMERA_SETTING_DISABLED_FOR_FILE_SOURCE"
      },
      {
        "parameter": "TriggerMode",
        "disabledWhen": {
          "all": [
            { "parameter": "SourceType", "comparison": "equals", "value": "File" }
          ]
        },
        "reasonCode": "IMAGE_CAMERA_SETTING_DISABLED_FOR_FILE_SOURCE"
      },
      {
        "parameter": "sourceType",
        "requiredPolicy": "optional",
        "aliasFor": "SourceType",
        "deprecated": true,
        "reasonCode": "IMAGE_SOURCE_TYPE_LEGACY_ALIAS"
      },
      {
        "parameter": "cameraId",
        "requiredPolicy": "optional",
        "aliasFor": "CameraId",
        "deprecated": true,
        "reasonCode": "IMAGE_CAMERA_ID_LEGACY_ALIAS"
      }
    ],
    "DeepLearning": [
      {
        "parameter": "ModelPath",
        "requiredPolicy": "required",
        "atLeastOneGroup": "deep-learning-model-source",
        "mutuallyExclusiveGroup": "deep-learning-model-source",
        "resourceKind": "model_resource",
        "reasonCode": "DEEP_LEARNING_MODEL_SOURCE_REQUIRED"
      },
      {
        "parameter": "ModelId",
        "requiredPolicy": "required",
        "atLeastOneGroup": "deep-learning-model-source",
        "mutuallyExclusiveGroup": "deep-learning-model-source",
        "resourceKind": "model_resource",
        "reasonCode": "DEEP_LEARNING_MODEL_SOURCE_REQUIRED"
      },
      {
        "parameter": "ModelCatalogPath",
        "requiredPolicy": "optional",
        "disabledWhen": {
          "any": [
            { "parameter": "ModelId", "comparison": "empty" },
            { "parameter": "ModelPath", "comparison": "not-empty" }
          ]
        },
        "resourceKind": "model_catalog",
        "reasonCode": "DEEP_LEARNING_CATALOG_REQUIRES_MODEL_ID"
      },
      {
        "parameter": "LabelsPath",
        "requiredPolicy": "optional",
        "resourceKind": "model_labels",
        "reasonCode": "DEEP_LEARNING_LABELS_OPTIONAL_FALLBACK"
      },
      {
        "parameter": "GpuDeviceId",
        "disabledWhen": {
          "all": [
            { "parameter": "UseGpu", "comparison": "equals", "value": false }
          ]
        },
        "reasonCode": "DEEP_LEARNING_GPU_DEVICE_DISABLED_WITHOUT_GPU"
      },
      {
        "parameter": "EnableInternalNms",
        "disabledWhen": {
          "all": [
            { "parameter": "OutputFormat", "comparison": "equals", "value": "EndToEndNms" }
          ]
        },
        "reasonCode": "DEEP_LEARNING_MODEL_OWNS_END_TO_END_NMS"
      },
      {
        "parameter": "NmsIouThreshold",
        "requiredWhen": {
          "all": [
            { "parameter": "OutputFormat", "comparison": "equals", "value": "RawYolo" },
            { "parameter": "EnableInternalNms", "comparison": "equals", "value": true }
          ]
        },
        "disabledWhen": {
          "any": [
            { "parameter": "OutputFormat", "comparison": "equals", "value": "EndToEndNms" },
            { "parameter": "EnableInternalNms", "comparison": "equals", "value": false }
          ]
        },
        "reasonCode": "DEEP_LEARNING_NMS_THRESHOLD_ACTIVE_FOR_INTERNAL_NMS"
      }
    ],
    "EdgeDetection": [
      {
        "parameter": "EdgeModelPath",
        "requiredPolicy": "optional",
        "requiredWhen": {
          "all": [
            { "parameter": "Method", "comparison": "equals", "value": "OnnxEdge" }
          ]
        },
        "disabledWhen": {
          "all": [
            { "parameter": "Method", "comparison": "not-equals", "value": "OnnxEdge" }
          ]
        },
        "atLeastOneGroup": "edge-model-source",
        "mutuallyExclusiveGroup": "edge-model-source",
        "resourceKind": "model_resource",
        "reasonCode": "EDGE_ONNX_MODEL_SOURCE_REQUIRED"
      },
      {
        "parameter": "EdgeModelId",
        "requiredPolicy": "optional",
        "requiredWhen": {
          "all": [
            { "parameter": "Method", "comparison": "equals", "value": "OnnxEdge" }
          ]
        },
        "disabledWhen": {
          "all": [
            { "parameter": "Method", "comparison": "not-equals", "value": "OnnxEdge" }
          ]
        },
        "atLeastOneGroup": "edge-model-source",
        "mutuallyExclusiveGroup": "edge-model-source",
        "resourceKind": "model_resource",
        "reasonCode": "EDGE_ONNX_MODEL_SOURCE_REQUIRED"
      },
      {
        "parameter": "ModelCatalogPath",
        "requiredPolicy": "optional",
        "disabledWhen": {
          "any": [
            { "parameter": "Method", "comparison": "not-equals", "value": "OnnxEdge" },
            { "parameter": "EdgeModelId", "comparison": "empty" },
            { "parameter": "EdgeModelPath", "comparison": "not-empty" }
          ]
        },
        "resourceKind": "model_catalog",
        "reasonCode": "EDGE_MODEL_CATALOG_REQUIRES_MODEL_ID"
      },
      {
        "parameter": "EdgeBinarizationThreshold",
        "requiredPolicy": "optional",
        "disabledWhen": {
          "all": [
            { "parameter": "Method", "comparison": "not-equals", "value": "OnnxEdge" }
          ]
        },
        "reasonCode": "EDGE_BINARIZATION_ONLY_FOR_ONNX"
      }
    ],
    "ResultOutput": [
      {
        "parameter": "SaveToFile",
        "resourceKind": "output_file",
        "reasonCode": "RESULT_OUTPUT_OPTIONAL_INTERNAL_FILE_WRITE"
      }
    ],
    "BlobAnalysis": [
      {
        "parameter": "FeatureFilter",
        "requiredPolicy": "optional",
        "reasonCode": "BLOB_FEATURE_FILTER_OPTIONAL"
      },
      {
        "parameter": "HueLow",
        "disabledWhen": {
          "all": [
            { "parameter": "EnableColorFilter", "comparison": "equals", "value": false }
          ]
        },
        "reasonCode": "BLOB_HSV_ONLY_WITH_COLOR_FILTER"
      },
      {
        "parameter": "HueHigh",
        "disabledWhen": {
          "all": [
            { "parameter": "EnableColorFilter", "comparison": "equals", "value": false }
          ]
        },
        "reasonCode": "BLOB_HSV_ONLY_WITH_COLOR_FILTER"
      },
      {
        "parameter": "SatLow",
        "disabledWhen": {
          "all": [
            { "parameter": "EnableColorFilter", "comparison": "equals", "value": false }
          ]
        },
        "reasonCode": "BLOB_HSV_ONLY_WITH_COLOR_FILTER"
      },
      {
        "parameter": "SatHigh",
        "disabledWhen": {
          "all": [
            { "parameter": "EnableColorFilter", "comparison": "equals", "value": false }
          ]
        },
        "reasonCode": "BLOB_HSV_ONLY_WITH_COLOR_FILTER"
      },
      {
        "parameter": "ValLow",
        "disabledWhen": {
          "all": [
            { "parameter": "EnableColorFilter", "comparison": "equals", "value": false }
          ]
        },
        "reasonCode": "BLOB_HSV_ONLY_WITH_COLOR_FILTER"
      },
      {
        "parameter": "ValHigh",
        "disabledWhen": {
          "all": [
            { "parameter": "EnableColorFilter", "comparison": "equals", "value": false }
          ]
        },
        "reasonCode": "BLOB_HSV_ONLY_WITH_COLOR_FILTER"
      }
    ]
  },
