{
  "schemaVersion": "clearvision.release-policy/v1",
  "defaultLicenseDisposition": "deny",
  "unknownLicenseDisposition": "block",
  "allowedLicenses": [
    "0BSD",
    "Apache-2.0",
    "BSD-2-Clause",
    "BSD-3-Clause",
    "ISC",
    "MIT",
    "MS-PL",
    "Unicode-3.0",
    "Zlib"
  ],
  "deniedLicenses": [
    "AGPL-1.0-only",
    "AGPL-1.0-or-later",
    "AGPL-3.0-only",
    "AGPL-3.0-or-later",
    "GPL-1.0-only",
    "GPL-1.0-or-later",
    "GPL-2.0-only",
    "GPL-2.0-or-later",
    "GPL-3.0-only",
    "GPL-3.0-or-later",
    "SSPL-1.0"
  ],
  "approvedExceptions": [],
  "pendingExceptions": [],
  "vulnerabilityPolicy": {
    "source": "NuGet audit advisory sources",
    "maximumDataAgeHours": 24,
    "unavailableDisposition": "block",
    "blockedSeverities": [
      "low",
      "moderate",
      "high",
      "critical"
    ]
  }
}
