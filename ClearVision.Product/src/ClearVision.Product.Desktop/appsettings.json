{
  "Database": {
    "Path": ""
  },
  "AiFlowGeneration": {
    "Provider": "OpenAI",
    "ApiKey": "",
    "Model": "deepseek-chat",
    "MaxRetries": 2,
    "TimeoutSeconds": 60,
    "MaxTokens": 4096,
    "BaseUrl": "https://api.deepseek.com/chat/completions"
  },
  "AI": {
    "VisionAgent": {
      "GenerateFlow": {
        "Enabled": true,
        "Mode": "scripted",
        "FallbackToScriptedOnPlannerFailure": true,
        "FallbackToLegacyOnFailure": false
      },
      "PlanPlanner": {
        "Enabled": true,
        "AllowRuleFallback": true,
        "TimeoutSeconds": 120
      }
    }
  },
  "Studio": {
    "WorkspaceV2Enabled": false,
    "NodePreviewInspectorEnabled": false,
    "PropertyPanelCapabilityEnabled": false,
    "PreviewPanelCapabilityEnabled": false,
    "CircleSearchV2ToolEnabled": true,
    "NPointCalibrationWorkbenchEnabled": true
  },
  "StationIngress": {
    "Enabled": false,
    "ListenMode": "Loopback",
    "Port": 5000,
    "SharedToken": "",
    "AllowInsecureDevelopment": false,
    "AllowMessagePack": true,
    "OfflineThresholdSeconds": 15,
    "ResultBufferPerStation": 200,
    "EventBufferSize": 1000,
    "HealthBufferPerStation": 100,
    "LogBufferPerStation": 100,
    "CommandBufferPerStation": 100
  }
}
