{
  "name": "clearvision-studio-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0",
    "npm": ">=10.8.2 <12"
  },
  "scripts": {
    "lint": "eslint . --max-warnings=0",
