{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "clearvision://studio-ui-next/r2-motion.v1",
  "title": "ClearVision Studio UI Next R2 motion inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedFrom", "sourceHash", "sourceFiles", "items"],
  "properties": {
    "schemaVersion": { "const": "r2-motion.v1" },
    "generatedFrom": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "sourceHash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "sourceFiles": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "items": { "type": "array", "items": { "$ref": "#/$defs/item" } }
  },
  "$defs": {
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "motionId",
        "purpose",
        "owner",
        "trigger",
        "target",
        "mechanism",
        "properties",
        "durationMs",
        "delayMs",
        "easing",
        "stableKey",
        "cancellation",
        "dispose",
        "reducedMotion",
        "focusAria",
        "risk"
        ,"sourceRefs"
      ],
      "properties": {
        "motionId": { "type": "string", "minLength": 1 },
        "purpose": { "enum": ["STATE_FEEDBACK", "SPATIAL_CONTINUITY", "FOCUS_SELECTION", "ACTION_COMPLETION"] },
        "owner": { "type": "string", "minLength": 1 },
        "trigger": { "type": "string", "minLength": 1 },
        "target": { "type": "string", "minLength": 1 },
        "mechanism": { "enum": ["CSS_TRANSITION", "CSS_ANIMATION", "VUE_TRANSITION", "VUE_TRANSITION_GROUP"] },
        "properties": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
        "durationMs": { "type": "number", "minimum": 0, "maximum": 800 },
        "delayMs": { "type": "number", "minimum": 0, "maximum": 0 },
        "easing": { "type": "string", "minLength": 1 },
        "stableKey": { "type": "string", "minLength": 1 },
        "cancellation": { "type": "string", "minLength": 1 },
        "dispose": { "type": "string", "minLength": 1 },
        "reducedMotion": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durationMs", "delayMs", "transformDistancePx", "infiniteAnimations"],
          "properties": {
            "durationMs": { "type": "number", "minimum": 0, "maximum": 1 },
            "delayMs": { "type": "number", "minimum": 0, "maximum": 0 },
            "transformDistancePx": { "type": "number", "minimum": 0, "maximum": 0 },
            "infiniteAnimations": { "type": "integer", "minimum": 0, "maximum": 0 }
          }
        },
        "focusAria": { "type": "string", "minLength": 1 },
        "risk": { "enum": ["LOW", "MEDIUM", "FORBIDDEN_ZONE"] }
        ,"sourceRefs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "minLength": 1 } }
      }
    }
  }
}
