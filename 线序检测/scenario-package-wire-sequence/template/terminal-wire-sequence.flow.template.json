{
  "name": "Terminal Wire Sequence Template",
  "description": "Full-image DeepLearning with ONNX-integrated NMS + DetectionSequenceJudge baseline.",
  "scenarioKey": "wire-sequence-terminal",
  "templateVersion": "1.6.0",
  "expectedSequence": [
    "Wire_Black",
    "Wire_Blue"
  ],
  "expectedDetectionCount": 2,
  "requiredResources": [
    "DeepLearning.ModelPath"
  ],
  "tunableParameters": [
    "DeepLearning.Confidence"
  ],
  "operators": [
    {
      "id": "op_1",
      "type": "ImageAcquisition",
      "name": "Acquire"
    },
    {
      "id": "op_2",
      "type": "DeepLearning",
      "name": "WireRootDetection",
      "params": {
        "ModelPath": "",
        "LabelsPath": "",
        "Confidence": "0.05",
        "InputSize": "640",
        "TargetClasses": "Wire_Black,Wire_Blue",
        "EnableInternalNms": "true",
        "OutputFormat": "EndToEndNms",
        "DetectionMode": "Object"
      }
    },
    {
      "id": "op_3",
      "type": "DetectionSequenceJudge",
      "name": "SequenceJudge",
      "params": {
        "ExpectedLabels": "Wire_Black,Wire_Blue",
        "SortBy": "CenterY",
        "Direction": "TopToBottom",
        "ExpectedCount": "2",
        "MinConfidence": "0.0"
      }
    },
    {
      "id": "op_4",
      "type": "ResultOutput",
      "name": "Output",
      "params": {
        "Format": "JSON",
        "SaveToFile": "false"
      }
    }
  ],
  "connections": [
    {
      "source": "op_1",
      "sourcePort": "Image",
      "target": "op_2",
      "targetPort": "Image"
    },
    {
      "source": "op_2",
      "sourcePort": "Objects",
      "target": "op_3",
      "targetPort": "Detections"
    },
    {
      "source": "op_2",
      "sourcePort": "Image",
      "target": "op_4",
      "targetPort": "Image"
    },
    {
      "source": "op_2",
      "sourcePort": "PostprocessDiagnostics",
      "target": "op_4",
      "targetPort": "Data"
    },
    {
      "source": "op_3",
      "sourcePort": "Diagnostics",
      "target": "op_4",
      "targetPort": "Result"
    },
    {
      "source": "op_3",
      "sourcePort": "Message",
      "target": "op_4",
      "targetPort": "Text"
    }
  ],
  "parametersNeedingReview": {
    "op_2": [
      "ModelPath",
      "OutputFormat",
      "Confidence"
    ],
    "op_3": [
      "ExpectedLabels",
      "ExpectedCount"
    ]
  }
}
