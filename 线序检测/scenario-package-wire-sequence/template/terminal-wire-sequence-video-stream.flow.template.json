{
  "name": "Terminal Wire Sequence Video Stream Template",
  "description": "Continuous camera acquisition with frame-change arrival trigger before ONNX-integrated wire sequence detection.",
  "scenarioKey": "wire-sequence-terminal-video-stream",
  "baseScenarioKey": "wire-sequence-terminal",
  "templateVersion": "1.6.0",
  "expectedSequence": [
    "Wire_Black",
    "Wire_Blue"
  ],
  "expectedDetectionCount": 2,
  "requiredResources": [
    "DeepLearning.ModelPath"
  ],
  "tunableParameters": [
    "FrameChangeTrigger.PixelThreshold",
    "FrameChangeTrigger.MinChangeRatio",
    "FrameChangeTrigger.MinChangePixels",
    "FrameChangeTrigger.CooldownMs",
    "FrameChangeTrigger.RoiX",
    "FrameChangeTrigger.RoiY",
    "FrameChangeTrigger.RoiW",
    "FrameChangeTrigger.RoiH",
    "DeepLearning.Confidence"
  ],
  "operators": [
    {
      "id": "op_1",
      "type": "ImageAcquisition",
      "name": "ContinuousAcquire",
      "params": {
        "SourceType": "Camera",
        "TriggerMode": "Continuous"
      }
    },
    {
      "id": "op_2",
      "type": "FrameChangeTrigger",
      "name": "ArrivalTrigger",
      "params": {
        "Enabled": "true",
        "ShortCircuitWhenNotTriggered": "true",
        "Profile": "line_fast_default",
        "PixelThreshold": "30",
        "MinChangeRatio": "0.02",
        "MinChangePixels": "500",
        "CooldownMs": "1200",
        "RoiX": "0",
        "RoiY": "0",
        "RoiW": "0",
        "RoiH": "0"
      }
    },
    {
      "id": "op_3",
      "type": "DeepLearning",
      "name": "WireRootDetection",
      "params": {
        "ModelPath": "",
        "LabelsPath": "",
        "Confidence": "0.05",
        "InputSize": "640",
        "TargetClasses": "Wire_Black,Wire_Blue",
        "EnableInternalNms": "false",
        "OutputFormat": "EndToEndNms",
        "DetectionMode": "Object"
      }
    },
    {
      "id": "op_4",
      "type": "DetectionSequenceJudge",
      "name": "SequenceJudge",
      "params": {
        "ExpectedLabels": "Wire_Black,Wire_Blue",
        "SortBy": "CenterY",
        "Direction": "TopToBottom",
        "ExpectedCount": "2",
        "MinConfidence": "0.0"
      }
    },
    {
      "id": "op_5",
      "type": "ResultOutput",
      "name": "Output",
      "params": {
        "Format": "JSON",
        "SaveToFile": "true"
      }
    }
  ],
  "connections": [
    {
      "source": "op_1",
      "sourcePort": "Image",
      "target": "op_2",
      "targetPort": "Image"
    },
    {
      "source": "op_2",
      "sourcePort": "Image",
      "target": "op_3",
      "targetPort": "Image"
    },
    {
      "source": "op_3",
      "sourcePort": "Objects",
      "target": "op_4",
      "targetPort": "Detections"
    },
    {
      "source": "op_3",
      "sourcePort": "Image",
      "target": "op_5",
      "targetPort": "Image"
    },
    {
      "source": "op_3",
      "sourcePort": "PostprocessDiagnostics",
      "target": "op_5",
      "targetPort": "Data"
    },
    {
      "source": "op_4",
      "sourcePort": "Diagnostics",
      "target": "op_5",
      "targetPort": "Result"
    },
    {
      "source": "op_4",
      "sourcePort": "Message",
      "target": "op_5",
      "targetPort": "Text"
    }
  ],
  "parametersNeedingReview": {
    "op_1": [
      "CameraId",
      "TriggerMode"
    ],
    "op_2": [
      "RoiX",
      "RoiY",
      "RoiW",
      "RoiH",
      "PixelThreshold",
      "MinChangeRatio",
      "MinChangePixels",
      "CooldownMs"
    ],
    "op_3": [
      "ModelPath",
      "LabelsPath",
      "OutputFormat",
      "Confidence"
    ],
    "op_4": [
      "ExpectedLabels",
      "ExpectedCount"
    ]
  },
  "productionReadiness": {
    "status": "blockedUntilConfigured",
    "blockingStages": [
      "run",
      "deploy",
      "publish"
    ],
    "blockingParameters": {
      "op_2": [
        "RoiX",
        "RoiY",
        "RoiW",
        "RoiH"
      ],
      "op_3": [
        "ModelPath",
        "LabelsPath"
      ]
    },
    "operatorMessages": {
      "op_2": "到料检测 ROI 仍为 0,0,0,0 时不能进入生产运行；请在 ArrivalTrigger 节点配置实际检测区域。",
      "op_3": "模型路径或标签路径为空时不能部署；请在 WireRootDetection 节点配置真实 ONNX 模型和标签文件。"
    }
  },
  "runtimeNotes": [
    "Set the camera binding triggerMode to Continuous and start with targetFrameRateFps between 5 and 10.",
    "Tune FrameChangeTrigger ROI only for arrival detection; detection ROI filtering is not part of this template.",
    "The template defaults to FrameChangeTrigger.Profile=line_fast_default; noise_guard and low_contrast are opt-in evidence profiles.",
    "When FrameChangeTrigger is not triggered, the flow cycle is short-circuited and does not publish OK/NG."
  ]
}
